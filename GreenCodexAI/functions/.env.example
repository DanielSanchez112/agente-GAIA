# ===================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ===================================================================
# Copia este archivo como '.env' y completa con tus valores reales
#
# IMPORTANTE: 
# - Nunca subas el archivo .env real a git
# - Mantén tus tokens seguros y privados
# - Regenera tokens si sospechas que fueron comprometidos
# ===================================================================

# === WHATSAPP BUSINESS API ===
# Token de verificación para el webhook (crea uno seguro y único)
# Ejemplo de token seguro: usa al menos 64 caracteres aleatorios
VERIFY_TOKEN="tu_token_de_verificacion_muy_seguro_de_64_caracteres_minimo"

# Token de acceso de WhatsApp Business API
# Obtenerlo desde: Facebook Developers > WhatsApp > Configuración > Token de acceso
WHATSAPP_TOKEN="tu_token_de_acceso_de_whatsapp_business_aqui"

# ID del número de teléfono de WhatsApp Business
# Obtenerlo desde: Facebook Developers > WhatsApp > Configuración > Números de teléfono
PHONE_NUMBER_ID="123456789012345"

# URL base de la API de Facebook Graph (normalmente no cambies esto)
GRAPH_API_URL="https://graph.facebook.com/v19.0"

# === WEATHER API ===
# API Key de OpenWeatherMap para datos climáticos en tiempo real
# Obtenerlo desde: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY="tu_api_key_de_openweathermap_aqui"

# === GOOGLE CLOUD / VERTEX AI ===
# Ubicación del proyecto de Google Cloud (opcional, por defecto: us-central1)
# Opciones comunes: us-central1, us-east1, europe-west1, asia-northeast1
GOOGLE_CLOUD_LOCATION="us-central1"

# NOTA: GCLOUD_PROJECT se configura automáticamente desde Firebase
# No necesitas configurarlo manualmente

# ===================================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ===================================================================

# 1. WHATSAPP BUSINESS API:
#    - Ve a https://developers.facebook.com/
#    - Crea una nueva app de tipo "Business"
#    - Agrega el producto "WhatsApp Business"
#    - Configura el webhook con la URL de tu Cloud Function
#    - Copia los tokens necesarios

# 2. OPENWEATHERMAP API:
#    - Ve a https://openweathermap.org/api
#    - Crea una cuenta gratuita
#    - Obtén tu API key desde el dashboard
#    - Plan gratuito: 1000 llamadas/día, suficiente para el bot

# 3. FIREBASE/GOOGLE CLOUD:
#    - Crea un proyecto en Firebase Console
#    - Habilita Vertex AI en Google Cloud Console
#    - Las credenciales se manejan automáticamente con Cloud Functions

# 4. WEBHOOK CONFIGURATION:
#    - URL del webhook: https://tu-proyecto.cloudfunctions.net/api/webhook
#    - Token de verificación: El mismo que pusiste en VERIFY_TOKEN
#    - Eventos suscritos: messages

# ===================================================================
# EJEMPLOS DE VALORES (NO USAR EN PRODUCCIÓN)
# ===================================================================

# VERIFY_TOKEN="yDP6oaBpTIgJyeayhvKMIpGacNbpH1kdYkayX6LuyC3reBcOymwvjjxvL4gV3JgcQ"
# WHATSAPP_TOKEN="EAAbWJ14fbZB4BPgSUfdD6UqGAFqjTw1DVpvWuMXtKFAnPUeEKhSqtEtVZCZBM2Hx..."
# PHONE_NUMBER_ID="838120969377896"
# OPENWEATHERMAP_API_KEY="abcd1234567890efghijklmnopqrstuv"

# ===================================================================
# NOTAS DE SEGURIDAD
# ===================================================================

# - Usa tokens largos y aleatorios para VERIFY_TOKEN
# - Nunca hardcodees tokens en el código
# - Regenera tokens periódicamente
# - Usa diferentes tokens para desarrollo y producción
# - Revisa regularmente los logs por actividad sospechosa

# ===================================================================
# COMANDOS ÚTILES PARA CONFIGURACIÓN
# ===================================================================

# Configurar variables en Firebase (alternativa al .env):
# firebase functions:config:set whatsapp.verify_token="tu_token"
# firebase functions:config:set whatsapp.token="tu_whatsapp_token"
# firebase functions:config:set whatsapp.phone_id="tu_phone_id"
# firebase functions:config:set weather.api_key="tu_openweather_key"

# Ver configuración actual:
# firebase functions:config:get

# ===================================================================